<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
           fx:controller="org.amrosman.jsmartclinic.ui.auth.FirstRunController"
           styleClass="auth-root" stylesheets="@../app.css">

    <VBox styleClass="auth-card" maxWidth="470" spacing="12">
        <HBox styleClass="brand-box, auth-brand" spacing="2">
            <Label text="JSmart" styleClass="brand"/>
            <Label text="Clinic" styleClass="brand, brand-accent"/>
        </HBox>
        <Label fx:id="titleLabel" text="Welcome to JSmartClinic" styleClass="auth-title"/>
        <Label fx:id="subtitleLabel" text="Set up your clinic and create the first administrator account"
               styleClass="auth-subtitle" wrapText="true"/>

        <VBox spacing="6">
            <Label fx:id="clinicLabel" text="Clinic name" styleClass="form-label"/>
            <TextField fx:id="clinicField" promptText="JSmart Clinic" styleClass="form-field"/>
        </VBox>

        <VBox spacing="6">
            <Label fx:id="fullNameLabel" text="Full name" styleClass="form-label"/>
            <TextField fx:id="fullNameField" promptText="Dr. Jane Doe" styleClass="form-field"/>
        </VBox>

        <VBox spacing="6">
            <Label fx:id="specialtyLabel" text="Specialty (optional)" styleClass="form-label"/>
            <TextField fx:id="specialtyField" promptText="General" styleClass="form-field"/>
        </VBox>

        <CheckBox fx:id="clinicianCheck" text="I also see patients (doctor)"/>

        <VBox spacing="6">
            <Label fx:id="usernameLabel" text="Username" styleClass="form-label"/>
            <TextField fx:id="usernameField" promptText="admin" styleClass="form-field"/>
        </VBox>

        <HBox spacing="12">
            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label fx:id="passwordLabel" text="Password" styleClass="form-label"/>
                <PasswordField fx:id="passwordField" promptText="At least 10 characters" styleClass="form-field"/>
            </VBox>
            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label fx:id="confirmLabel" text="Confirm password" styleClass="form-label"/>
                <PasswordField fx:id="confirmField" promptText="Repeat password" styleClass="form-field"
                               onAction="#onCreate"/>
            </VBox>
        </HBox>

        <Label fx:id="errorLabel" styleClass="error-text" wrapText="true" managed="false" visible="false"/>

        <Button fx:id="createButton" text="Create clinic" onAction="#onCreate" styleClass="primary-button"
                maxWidth="Infinity"/>

        <padding>
            <Insets top="38" right="42" bottom="32" left="42"/>
        </padding>
    </VBox>
</StackPane>
