<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.amrosman.jsmartclinic.ui.prescriptions.PrescriptionsController"
      styleClass="page-body" spacing="14">
    <padding>
        <Insets top="18" right="18" bottom="18" left="18"/>
    </padding>

    <HBox styleClass="toolbar-row" spacing="10">
        <TextField fx:id="searchField" promptText="Filter by patient or prescriber" styleClass="search-field"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="countLabel" styleClass="muted"/>
        <Button text="Refresh" onAction="#onRefresh" styleClass="ghost-button"/>
        <Button fx:id="viewButton" text="View" onAction="#onView" styleClass="secondary-button"/>
        <Button fx:id="printButton" text="Print PDF" onAction="#onPrint" styleClass="secondary-button"/>
        <Button fx:id="renewButton" text="Renew" onAction="#onRenew" styleClass="secondary-button"/>
        <Button fx:id="newButton" text="+  New prescription" onAction="#onNew" styleClass="primary-button"/>
    </HBox>

    <HBox spacing="14" VBox.vgrow="ALWAYS">
        <VBox styleClass="card" spacing="10" HBox.hgrow="ALWAYS">
            <HBox styleClass="card-header" spacing="10">
                <Label text="Recent prescriptions" styleClass="card-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="hintLabel" styleClass="muted"/>
            </HBox>
            <TableView fx:id="prescriptionTable" VBox.vgrow="ALWAYS" styleClass="small-table">
                <columns>
                    <TableColumn fx:id="issuedColumn" text="Issued" prefWidth="180"/>
                    <TableColumn fx:id="patientColumn" text="Patient" prefWidth="220"/>
                    <TableColumn fx:id="prescriberColumn" text="Prescriber" prefWidth="170"/>
                    <TableColumn fx:id="itemsColumn" text="Items" prefWidth="70"/>
                    <TableColumn fx:id="notesColumn" text="Notes" prefWidth="240"/>
                </columns>
            </TableView>
        </VBox>

        <VBox styleClass="card" spacing="10" prefWidth="480" minWidth="380">
            <Label fx:id="detailTitle" text="Prescription details" styleClass="card-title"/>
            <Label fx:id="detailMeta" styleClass="muted" wrapText="true"/>
            <TableView fx:id="itemTable" VBox.vgrow="ALWAYS" styleClass="small-table">
                <columns>
                    <TableColumn fx:id="drugColumn" text="Drug" prefWidth="180"/>
                    <TableColumn fx:id="doseColumn" text="Dose / frequency" prefWidth="150"/>
                    <TableColumn fx:id="durationColumn" text="Duration" prefWidth="100"/>
                    <TableColumn fx:id="instructionsColumn" text="Instructions" prefWidth="180"/>
                </columns>
            </TableView>
            <Label fx:id="detailNotes" styleClass="muted" wrapText="true"/>
        </VBox>
    </HBox>
</VBox>
