<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.amrosman.jsmartclinic.ui.encounters.EncountersController"
      styleClass="page-body" spacing="14">
    <padding>
        <Insets top="18" right="18" bottom="18" left="18"/>
    </padding>

    <HBox styleClass="toolbar-row" spacing="10">
        <TextField fx:id="searchField" promptText="Filter by patient, MRN or provider" styleClass="search-field"/>
        <ComboBox fx:id="statusFilter" styleClass="form-field" prefWidth="150"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="countLabel" styleClass="muted"/>
        <Button text="Refresh" onAction="#onRefresh" styleClass="ghost-button"/>
        <Button fx:id="openButton" text="Open encounter" onAction="#onOpen" styleClass="secondary-button"/>
        <Button fx:id="newButton" text="+  New encounter" onAction="#onNew" styleClass="primary-button"/>
    </HBox>

    <Label fx:id="permissionHint" styleClass="muted" wrapText="true" managed="false" visible="false"/>

    <VBox styleClass="card" spacing="10" VBox.vgrow="ALWAYS">
        <HBox styleClass="card-header" spacing="10">
            <Label text="Clinical encounters" styleClass="card-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="draftLabel" styleClass="muted"/>
        </HBox>
        <TableView fx:id="encounterTable" VBox.vgrow="ALWAYS" styleClass="small-table">
            <columns>
                <TableColumn fx:id="dateColumn" text="Date" prefWidth="180"/>
                <TableColumn fx:id="patientColumn" text="Patient" prefWidth="220"/>
                <TableColumn fx:id="mrnColumn" text="MRN" prefWidth="110"/>
                <TableColumn fx:id="providerColumn" text="Provider" prefWidth="160"/>
                <TableColumn fx:id="specialtyColumn" text="Specialty" prefWidth="140"/>
                <TableColumn fx:id="statusColumn" text="Status" prefWidth="110"/>
                <TableColumn fx:id="signedColumn" text="Signed" prefWidth="160"/>
            </columns>
        </TableView>
    </VBox>
</VBox>
