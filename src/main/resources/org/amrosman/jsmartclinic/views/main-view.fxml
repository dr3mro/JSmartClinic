<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.amrosman.jsmartclinic.ui.MainController"
            styleClass="app-root" stylesheets="@app.css">

    <fx:define>
        <ToggleGroup fx:id="navGroup"/>
    </fx:define>

    <left>
        <VBox styleClass="sidebar">
            <HBox styleClass="brand-box" spacing="2">
                <Label text="JSmart" styleClass="brand"/>
                <Label text="Clinic" styleClass="brand, brand-accent"/>
            </HBox>

            <Label fx:id="mainSectionLabel" text="MAIN" styleClass="nav-section"/>
            <ToggleButton fx:id="navDashboard" text="Dashboard" userData="dashboard" toggleGroup="$navGroup"
                          selected="true" onAction="#onNav" styleClass="nav-button" maxWidth="Infinity">
                <graphic><FontIcon iconLiteral="fas-home" styleClass="nav-icon"/></graphic>
            </ToggleButton>
            <ToggleButton fx:id="navPatients" text="Patients" userData="patients" toggleGroup="$navGroup"
                          onAction="#onNav" styleClass="nav-button" maxWidth="Infinity">
                <graphic><FontIcon iconLiteral="fas-users" styleClass="nav-icon"/></graphic>
            </ToggleButton>
            <ToggleButton fx:id="navAppointments" text="Appointments" userData="appointments" toggleGroup="$navGroup"
                          onAction="#onNav" styleClass="nav-button" maxWidth="Infinity">
                <graphic><FontIcon iconLiteral="fas-calendar-day" styleClass="nav-icon"/></graphic>
            </ToggleButton>

            <Label fx:id="clinicalSectionLabel" text="CLINICAL" styleClass="nav-section"/>
            <ToggleButton fx:id="navEncounters" text="Encounters" userData="encounters" toggleGroup="$navGroup"
                          onAction="#onNav" styleClass="nav-button" maxWidth="Infinity">
                <graphic><FontIcon iconLiteral="fas-notes-medical" styleClass="nav-icon"/></graphic>
            </ToggleButton>
            <ToggleButton fx:id="navPrescriptions" text="Prescriptions" userData="prescriptions" toggleGroup="$navGroup"
                          onAction="#onNav" styleClass="nav-button" maxWidth="Infinity">
                <graphic><FontIcon iconLiteral="fas-prescription" styleClass="nav-icon"/></graphic>
            </ToggleButton>
            <ToggleButton fx:id="navLabs" text="Lab Results" userData="labs" toggleGroup="$navGroup"
                          onAction="#onNav" styleClass="nav-button" maxWidth="Infinity">
                <graphic><FontIcon iconLiteral="fas-flask" styleClass="nav-icon"/></graphic>
            </ToggleButton>

            <Label fx:id="adminSectionLabel" text="ADMIN" styleClass="nav-section"/>
            <ToggleButton fx:id="navBilling" text="Billing" userData="billing" toggleGroup="$navGroup"
                          onAction="#onNav" styleClass="nav-button" maxWidth="Infinity">
                <graphic><FontIcon iconLiteral="fas-file-invoice-dollar" styleClass="nav-icon"/></graphic>
            </ToggleButton>
            <ToggleButton fx:id="navReports" text="Reports" userData="reports" toggleGroup="$navGroup"
                          onAction="#onNav" styleClass="nav-button" maxWidth="Infinity">
                <graphic><FontIcon iconLiteral="fas-chart-pie" styleClass="nav-icon"/></graphic>
            </ToggleButton>
            <ToggleButton fx:id="navSettings" text="Settings" userData="settings" toggleGroup="$navGroup"
                          onAction="#onNav" styleClass="nav-button" maxWidth="Infinity">
                <graphic><FontIcon iconLiteral="fas-cog" styleClass="nav-icon"/></graphic>
            </ToggleButton>

            <Region VBox.vgrow="ALWAYS"/>

            <VBox styleClass="user-box" spacing="8">
                <HBox spacing="10" styleClass="user-row">
                    <StackPane styleClass="avatar-small">
                        <Label fx:id="sidebarAvatar" text="DR" styleClass="avatar-small-text"/>
                    </StackPane>
                    <VBox spacing="2">
                        <Label fx:id="sidebarName" text="Dr. Admin" styleClass="user-name"/>
                        <Label fx:id="sidebarRole" text="General Practice" styleClass="user-role"/>
                    </VBox>
                </HBox>
                <HBox spacing="8">
                    <Button text="Lock" onAction="#onLock" styleClass="sidebar-button" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                    <Button fx:id="logoutButton" text="Sign out" onAction="#onLogout" styleClass="sidebar-button" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                </HBox>
            </VBox>
        </VBox>
    </left>

    <top>
        <HBox styleClass="topbar">
            <VBox>
                <Label fx:id="pageTitle" text="Dashboard" styleClass="page-title"/>
                <Label fx:id="dateLabel" styleClass="page-subtitle"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <TextField fx:id="searchField" promptText="Search patients by name, MRN or phone" styleClass="search-field"/>
            <Button fx:id="newPatientButton" text="+  New Patient" onAction="#onNewPatient" styleClass="primary-button"/>
        </HBox>
    </top>

    <center>
        <StackPane fx:id="contentArea" styleClass="content-area">
            <padding>
                <Insets top="0" right="0" bottom="0" left="0"/>
            </padding>
        </StackPane>
    </center>
</BorderPane>
