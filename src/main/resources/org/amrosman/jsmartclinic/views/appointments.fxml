<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.amrosman.jsmartclinic.ui.appointments.AppointmentsController"
      styleClass="page-body" spacing="14">
    <padding>
        <Insets top="18" right="18" bottom="18" left="18"/>
    </padding>

    <fx:define>
        <ToggleGroup fx:id="viewGroup"/>
    </fx:define>

    <HBox styleClass="toolbar-row" spacing="10">
        <ComboBox fx:id="providerCombo" promptText="Provider" styleClass="form-field" prefWidth="210"/>
        <DatePicker fx:id="datePicker" styleClass="form-field" prefWidth="150"/>
        <ToggleButton fx:id="dayToggle" text="Day" selected="true" toggleGroup="$viewGroup"
                      styleClass="secondary-button"/>
        <ToggleButton fx:id="weekToggle" text="Week" toggleGroup="$viewGroup" styleClass="secondary-button"/>
        <Button text="Today" onAction="#onToday" styleClass="ghost-button"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="selectedLabel" styleClass="muted"/>
        <Button fx:id="checkInButton" text="Check in" onAction="#onCheckIn" styleClass="secondary-button"/>
        <Button fx:id="startButton" text="Start visit" onAction="#onStartVisit" styleClass="secondary-button"/>
        <Button fx:id="completeButton" text="Complete" onAction="#onComplete" styleClass="secondary-button"/>
        <Button fx:id="cancelButton" text="Cancel" onAction="#onCancel" styleClass="danger-button"/>
        <Button fx:id="newButton" text="+  New appointment" onAction="#onNew" styleClass="primary-button"/>
    </HBox>

    <HBox spacing="14" VBox.vgrow="ALWAYS">
        <VBox styleClass="card" spacing="10" HBox.hgrow="ALWAYS">
            <HBox styleClass="card-header" spacing="10">
                <Label fx:id="calendarTitle" text="Day view" styleClass="card-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="rescheduleButton" text="Reschedule" onAction="#onReschedule"
                        styleClass="ghost-button"/>
                <Button fx:id="openChartButton" text="Open chart" onAction="#onOpenChart"
                        styleClass="ghost-button"/>
                <Button fx:id="encounterButton" text="Start encounter" onAction="#onStartEncounter"
                        styleClass="ghost-button"/>
            </HBox>
            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="content-scroll">
                <GridPane fx:id="calendarGrid" styleClass="calendar-grid" hgap="2" vgap="2"/>
            </ScrollPane>
        </VBox>

        <VBox styleClass="card" spacing="10" prefWidth="330" minWidth="300">
            <HBox styleClass="card-header" spacing="10">
                <Label text="Waiting room" styleClass="card-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="waitingCount" styleClass="muted"/>
            </HBox>
            <TableView fx:id="waitingTable" VBox.vgrow="ALWAYS" styleClass="small-table">
                <columns>
                    <TableColumn fx:id="waitingPatient" text="Patient" prefWidth="150"/>
                    <TableColumn fx:id="waitingTime" text="Since" prefWidth="70"/>
                    <TableColumn fx:id="waitingMinutes" text="Wait" prefWidth="70"/>
                    <TableColumn fx:id="waitingStatus" text="Status" prefWidth="110"/>
                </columns>
            </TableView>
            <Label text="Checked-in patients appear here while they wait for their provider." wrapText="true"
                   styleClass="muted"/>
        </VBox>
    </HBox>
</VBox>
