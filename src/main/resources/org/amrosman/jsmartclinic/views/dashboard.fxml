<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.amrosman.jsmartclinic.ui.dashboard.DashboardController"
      styleClass="page-body" spacing="18">
    <padding>
        <Insets top="18" right="18" bottom="18" left="18"/>
    </padding>

    <HBox spacing="16">
        <HBox styleClass="card, stat-card" HBox.hgrow="ALWAYS" maxWidth="Infinity">
            <StackPane styleClass="stat-icon, icon-teal">
                <FontIcon iconLiteral="fas-calendar-day" styleClass="stat-icon-text"/>
            </StackPane>
            <VBox>
                <Label fx:id="statAppointments" text="—" styleClass="stat-value"/>
                <Label text="Today's appointments" styleClass="stat-label"/>
            </VBox>
        </HBox>
        <HBox styleClass="card, stat-card" HBox.hgrow="ALWAYS" maxWidth="Infinity">
            <StackPane styleClass="stat-icon, icon-amber">
                <FontIcon iconLiteral="fas-hourglass-half" styleClass="stat-icon-text"/>
            </StackPane>
            <VBox>
                <Label fx:id="statWaiting" text="—" styleClass="stat-value"/>
                <Label text="Patients waiting" styleClass="stat-label"/>
            </VBox>
        </HBox>
        <HBox styleClass="card, stat-card" HBox.hgrow="ALWAYS" maxWidth="Infinity">
            <StackPane styleClass="stat-icon, icon-blue">
                <FontIcon iconLiteral="fas-user-plus" styleClass="stat-icon-text"/>
            </StackPane>
            <VBox>
                <Label fx:id="statNew" text="—" styleClass="stat-value"/>
                <Label text="New patients this week" styleClass="stat-label"/>
            </VBox>
        </HBox>
        <HBox styleClass="card, stat-card" HBox.hgrow="ALWAYS" maxWidth="Infinity">
            <StackPane styleClass="stat-icon, icon-rose">
                <FontIcon iconLiteral="fas-flask" styleClass="stat-icon-text"/>
            </StackPane>
            <VBox>
                <Label fx:id="statLabs" text="—" styleClass="stat-value"/>
                <Label text="Pending lab results" styleClass="stat-label"/>
            </VBox>
        </HBox>
        <HBox styleClass="card, stat-card" HBox.hgrow="ALWAYS" maxWidth="Infinity">
            <StackPane styleClass="stat-icon, icon-teal">
                <FontIcon iconLiteral="fas-coins" styleClass="stat-icon-text"/>
            </StackPane>
            <VBox>
                <Label fx:id="statRevenue" text="—" styleClass="stat-value"/>
                <Label text="Collected today" styleClass="stat-label"/>
            </VBox>
        </HBox>
    </HBox>

    <HBox spacing="16" VBox.vgrow="ALWAYS">
        <VBox styleClass="card" spacing="12" HBox.hgrow="ALWAYS">
            <HBox styleClass="card-header" spacing="10">
                <Label text="Today's schedule" styleClass="card-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="scheduleCount" styleClass="muted"/>
                <Button text="Refresh" onAction="#onRefresh" styleClass="ghost-button"/>
            </HBox>
            <TableView fx:id="scheduleTable" VBox.vgrow="ALWAYS" styleClass="small-table">
                <columns>
                    <TableColumn fx:id="scheduleTime" text="Time" prefWidth="80"/>
                    <TableColumn fx:id="schedulePatient" text="Patient" prefWidth="220"/>
                    <TableColumn fx:id="scheduleProvider" text="Provider" prefWidth="160"/>
                    <TableColumn fx:id="scheduleReason" text="Reason" prefWidth="220"/>
                    <TableColumn fx:id="scheduleStatus" text="Status" prefWidth="120"/>
                </columns>
            </TableView>
        </VBox>

        <VBox styleClass="card" spacing="12" prefWidth="380" minWidth="320">
            <HBox styleClass="card-header" spacing="10">
                <Label text="Recent patients" styleClass="card-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="All patients" onAction="#onOpenPatients" styleClass="ghost-button"/>
            </HBox>
            <TableView fx:id="recentPatientsTable" VBox.vgrow="ALWAYS" styleClass="small-table">
                <columns>
                    <TableColumn fx:id="recentName" text="Patient" prefWidth="180"/>
                    <TableColumn fx:id="recentMrn" text="MRN" prefWidth="100"/>
                    <TableColumn fx:id="recentAge" text="Age" prefWidth="60"/>
                </columns>
            </TableView>
            <HBox spacing="8">
                <Button fx:id="newPatientButton" text="+  New patient" onAction="#onNewPatient"
                        styleClass="primary-button" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                <Button fx:id="newAppointmentButton" text="Schedule" onAction="#onNewAppointment"
                        styleClass="secondary-button" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
            </HBox>
        </VBox>
    </HBox>
</VBox>
