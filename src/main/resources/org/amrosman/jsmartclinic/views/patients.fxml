<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.amrosman.jsmartclinic.ui.patients.PatientsController"
      styleClass="page-body" spacing="14">

    <HBox styleClass="toolbar-row">
        <TextField fx:id="searchField" promptText="Search by name, MRN or phone" styleClass="search-field"/>
        <CheckBox fx:id="archivedCheck" text="Include archived"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="chartButton" text="Open chart" onAction="#onOpenChart" styleClass="secondary-button"/>
        <Button fx:id="editButton" text="Edit" onAction="#onEdit" styleClass="secondary-button"/>
        <Button fx:id="archiveButton" text="Archive" onAction="#onArchive" styleClass="danger-button"/>
        <Button fx:id="newButton" text="+  New patient" onAction="#onNew" styleClass="primary-button"/>
    </HBox>

    <VBox styleClass="card" spacing="10" VBox.vgrow="ALWAYS">
        <HBox styleClass="card-header" spacing="10">
            <Label text="Patient registry" styleClass="card-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="countLabel" styleClass="muted"/>
        </HBox>
        <TableView fx:id="patientTable" VBox.vgrow="ALWAYS" styleClass="small-table">
            <columns>
                <TableColumn fx:id="nameColumn" text="Patient" prefWidth="240"/>
                <TableColumn fx:id="mrnColumn" text="MRN" prefWidth="110"/>
                <TableColumn fx:id="phoneColumn" text="Phone" prefWidth="150"/>
                <TableColumn fx:id="dobColumn" text="Date of birth" prefWidth="130"/>
                <TableColumn fx:id="ageColumn" text="Age" prefWidth="70"/>
                <TableColumn fx:id="statusColumn" text="Status" prefWidth="110"/>
            </columns>
        </TableView>
        <HBox styleClass="toolbar-row" spacing="12">
            <Label fx:id="pageLabel" styleClass="muted"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="previousButton" text="← Previous" onAction="#onPrevious" styleClass="secondary-button"/>
            <Button fx:id="nextButton" text="Next →" onAction="#onNext" styleClass="secondary-button"/>
        </HBox>
        <padding>
            <Insets top="10" right="10" bottom="10" left="10"/>
        </padding>
    </VBox>
</VBox>
